<?xml version="1.0"?>
<!--
  ENG-654 Project 1G : AgileX UMR (as a prismatic joint along world X) + UR12e
  Kinematic model only (simple primitives for the base; UR meshes can be added
  from ur_description for visualisation).

  Arm numbers: Universal_Robots_ROS2_Description, config/ur12e/default_kinematics.yaml
  Base:        AgileX UMR, 830 x 540 x 410 mm (arm mounted on top-plate centre).
  Joint limits: all six arm joints restricted to [-pi, pi] (TA instruction).
  Mount yaw = pi so that the UR controller "base" frame (= DH frame 0)
  is parallel to the world frame.
-->
<robot name="umr_ur12e">
  <link name="world"/>

  <!-- ===================== mobile base: prismatic joint 0 ===================== -->
  <link name="umr_base_link">
    <visual>
      <origin xyz="0 0 0.205" rpy="0 0 0"/>
      <geometry><box size="0.83 0.54 0.41"/></geometry>
    </visual>
  </link>
  <joint name="base_x_joint" type="prismatic">
    <parent link="world"/>
    <child link="umr_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="1000" velocity="1.5"/>
  </joint>

  <!-- arm mounted at the centre of the 410 mm-high top plate -->
  <link name="base_link"/>
  <joint name="umr_to_ur_mount" type="fixed">
    <parent link="umr_base_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.41" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- ================================ UR12e ================================= -->
  <link name="base_link_inertia"/>
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
  </joint>

  <link name="shoulder_link"/>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1807" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="330" velocity="2.0944"/>
  </joint>

  <link name="upper_arm_link"/>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="330" velocity="2.0944"/>
  </joint>

  <link name="forearm_link"/>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="-0.6127 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="150" velocity="3.1416"/>
  </joint>

  <link name="wrist_1_link"/>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="-0.57155 0 0.17415" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="54" velocity="3.1416"/>
  </joint>

  <link name="wrist_2_link"/>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 -0.11985 -2.458164590756244e-11" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="54" velocity="3.1416"/>
  </joint>

  <link name="wrist_3_link"/>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0.11655 -2.390480459346185e-11" rpy="1.570796326589793 3.141592653589793 3.141592653589793"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="54" velocity="3.1416"/>
  </joint>

  <!-- ROS-Industrial frames -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 -1.5707963267948966 -1.5707963267948966"/>
  </joint>
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 1.5707963267948966"/>
  </joint>
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
  </joint>
</robot>
